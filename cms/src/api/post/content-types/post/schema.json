{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "content": {
      "type": "dynamiczone",
      "components": [
        "post.block-video",
        "post.block-text",
        "post.block-quote",
        "post.block-image",
        "post.block-cta",
        "post.block-code"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "uid": {
      "type": "uid",
      "required": true
    }
  }
}
